<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Direct Input Watcher Configuration</Title>
    <Description>IConfiguration binding for DirectInputWatcher; register the controller watcher from appsettings.json or any other configuration provider.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>directinput;configuration;appsettings;options;windows</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- Development default: build against the sibling project. -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\DirectInputWatcher\DirectInputWatcher.csproj" />
  </ItemGroup>

  <!-- Package mode (-p:UseProjectReferences=false): build against the published package.
       Both branches produce the same nuspec dependency; only the compile-time binding differs. -->
  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="DirectInputWatcher" Version="$(DScannerPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
