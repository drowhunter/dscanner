<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Direct Input Watcher</Title>
    <Description>Watch every attached DirectInput and XInput game controller for button, axis, and POV activity as Rx event streams, with USB hot-plug reconciliation and axis calibration.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>directinput;xinput;joystick;gamepad;controller;rx;windows</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />

    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
